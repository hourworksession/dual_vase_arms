# systemd service: starts the camera server at boot.
# Install (on the camera Pi, replace "pi" with your username if different):
#   sudo cp cellcam.service /etc/systemd/system/
#   sudo systemctl enable --now cellcam
[Unit]
Description=Cell camera stream (cellcam.py)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
ExecStart=/usr/bin/python3 /home/pi/cellcam/cellcam.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
